@model PaginatedList<Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-journal-bookmark-fill me-2"></i>Courses</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Course
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
            <div class="col-md-8">
                <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by course name or instructor..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Search</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th><a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]" asp-route-searchTerm="@ViewData["CurrentFilter"]" class="text-decoration-none text-dark">Course Name <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th>Instructor</th>
                    <th><a asp-action="Index" asp-route-sortOrder="@ViewData["DurationSort"]" asp-route-searchTerm="@ViewData["CurrentFilter"]" class="text-decoration-none text-dark">Duration <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th><a asp-action="Index" asp-route-sortOrder="@ViewData["FeesSort"]" asp-route-searchTerm="@ViewData["CurrentFilter"]" class="text-decoration-none text-dark">Fees <i class="bi bi-arrow-down-up small"></i></a></th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No courses found.</td></tr>
                }
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.CourseName</td>
                        <td>@course.InstructorName</td>
                        <td>@course.Duration</td>
                        <td>@course.Fees.ToString("C0")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                    data-url="@Url.Action("Delete", new { id = course.Id })"
                                    data-name="@course.CourseName" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    @{
        ViewData["PageIndex"] = Model.PageIndex;
        ViewData["TotalPages"] = Model.TotalPages;
        ViewData["PagerAction"] = "Index";
    }
    <partial name="_Pagination" />
</div>

@section Scripts {
    <form id="deleteForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function () {
                const url = this.dataset.url;
                const name = this.dataset.name;
                Swal.fire({
                    title: 'Delete Course?',
                    text: `Are you sure you want to delete "${name}"? This cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.getElementById('deleteForm');
                        form.action = url;
                        form.submit();
                    }
                });
            });
        });
    </script>
}
