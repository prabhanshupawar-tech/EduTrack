@model Course
@{
    ViewData["Title"] = "Add Course";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-journal-plus me-2"></i>Add Course</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CourseName" class="form-label"></label>
                    <input asp-for="CourseName" class="form-control" placeholder="e.g. Full Stack .NET Development" />
                    <span asp-validation-for="CourseName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InstructorName" class="form-label"></label>
                    <input asp-for="InstructorName" class="form-control" placeholder="Instructor's name" />
                    <span asp-validation-for="InstructorName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label"></label>
                    <input asp-for="Duration" class="form-control" placeholder="e.g. 3 Months" />
                    <span asp-validation-for="Duration" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Fees" class="form-label"></label>
                    <input asp-for="Fees" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Fees" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Course description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Save Course</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
