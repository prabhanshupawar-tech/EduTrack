@model Course
@{
    ViewData["Title"] = "Course Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-journal-text me-2"></i>Course Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6"><strong>Course Name:</strong> @Model.CourseName</div>
            <div class="col-md-6"><strong>Instructor:</strong> @Model.InstructorName</div>
            <div class="col-md-6"><strong>Duration:</strong> @Model.Duration</div>
            <div class="col-md-6"><strong>Fees:</strong> @Model.Fees.ToString("C0")</div>
            <div class="col-12"><strong>Description:</strong> @Model.Description</div>
            <div class="col-md-6"><strong>Created:</strong> @Model.CreatedDate.ToString("dd MMM yyyy")</div>
        </div>
        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-people me-1"></i> Enrolled Students</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Student</th><th>Enrollment Date</th><th>Status</th></tr>
            </thead>
            <tbody>
                @if (!Model.Enrollments.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">No students enrolled yet.</td></tr>
                }
                @foreach (var e in Model.Enrollments)
                {
                    <tr>
                        <td>@e.Student?.FullName</td>
                        <td>@e.EnrollmentDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge bg-@(e.Status == "Active" ? "success" : e.Status == "Completed" ? "primary" : "secondary")">@e.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
