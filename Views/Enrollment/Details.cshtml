@model Enrollment
@{
    ViewData["Title"] = "Enrollment Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-clipboard-data-fill me-2"></i>Enrollment Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6"><strong>Student:</strong> @Model.Student?.FullName</div>
            <div class="col-md-6"><strong>Course:</strong> @Model.Course?.CourseName</div>
            <div class="col-md-6"><strong>Enrollment Date:</strong> @Model.EnrollmentDate.ToString("dd MMM yyyy")</div>
            <div class="col-md-6">
                <strong>Status:</strong>
                <span class="badge bg-@(Model.Status == "Active" ? "success" : Model.Status == "Completed" ? "primary" : "secondary")">@Model.Status</span>
            </div>
        </div>
        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
        </div>
    </div>
</div>
