@model EduTrack.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
    <h1 class="mt-3">Oops! Something went wrong.</h1>
    <p class="text-muted">An error occurred while processing your request. Please try again, and if the problem persists, contact the administrator.</p>

    @if (Model != null && Model.ShowRequestId)
    {
        <p class="text-muted"><small>Request ID: <code>@Model.RequestId</code></small></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house-fill me-1"></i> Back to Dashboard
    </a>
</div>
